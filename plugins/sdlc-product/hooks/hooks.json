{
  "PreToolUse": [
    {
      "matcher": "Execute",
      "commandRegex": "(?:^|[;&|(`'\"\\s])(?:(?:[^\\s;&|()`'\"]*/)?git(?:\\s+-\\S+(?:\\s+[^\\s-]\\S*)?)*\\s+push(?![\\w-])|(?:[^\\s;&|()`'\"]*/)?gh\\s+(?:pr\\s+(?:create|merge)(?![\\w-])|api(?=[^;&|\\n]*(?:pulls|git/refs))(?=[^;&|\\n]*(?:(?:-X|--method)[=\\s]*(?:POST|PUT|PATCH|DELETE)|\\s(?:-f|-F|--field|--raw-field|--input)[=\\s]))))",
      "hooks": [
        {
          "type": "command",
          "command": "echo 'Blocked by sdlc stage policy: this stage cannot push or open PRs. Hand off through the ticket.' >&2; exit 2",
          "timeout": 10
        }
      ]
    }
  ]
}
